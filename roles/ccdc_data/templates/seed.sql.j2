-- {{ ansible_managed }}
-- ccdc_data sample schema. The mysql:8 image executes files in
-- /docker-entrypoint-initdb.d/ once, on first database initialization only.
-- Runs against the MYSQL_DATABASE ({{ ccdc_data_mysql_database }}).

USE `{{ ccdc_data_mysql_database }}`;

CREATE TABLE IF NOT EXISTS customers (
  id INT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(100) NOT NULL,
  email VARCHAR(150) NOT NULL,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS orders (
  id INT AUTO_INCREMENT PRIMARY KEY,
  customer_id INT NOT NULL,
  product VARCHAR(150) NOT NULL,
  amount DECIMAL(10,2) NOT NULL,
  order_date DATE NOT NULL,
  FOREIGN KEY (customer_id) REFERENCES customers(id)
);

