# {{ ansible_managed }}
# CCDC SSO stack: Keycloak (+ PostgreSQL) and two demo JSON APIs.
# Rendered by the ccdc_sso Ansible role. Do not edit by hand.
---
services:
  postgres:
    image: {{ ccdc_sso_postgres_image }}
    restart: unless-stopped
    environment:
      - POSTGRES_DB={{ ccdc_sso_postgres_db }}
      - POSTGRES_USER={{ ccdc_sso_postgres_user }}
      - POSTGRES_PASSWORD={{ ccdc_sso_postgres_password }}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ ccdc_sso_postgres_user }} -d {{ ccdc_sso_postgres_db }}"]
      interval: 15s
      timeout: 10s
      retries: 20

  keycloak:
    image: {{ ccdc_sso_keycloak_image }}
    restart: unless-stopped
    command: ["start-dev"]
    environment:
      # --- Database wiring ---
      - KC_DB=postgres
      - KC_DB_URL=jdbc:postgresql://postgres:5432/{{ ccdc_sso_postgres_db }}
      - KC_DB_USERNAME={{ ccdc_sso_postgres_user }}
      - KC_DB_PASSWORD={{ ccdc_sso_postgres_password }}
      # --- Bootstrap admin account ---
      - KEYCLOAK_ADMIN={{ ccdc_sso_keycloak_admin }}
      - KEYCLOAK_ADMIN_PASSWORD={{ ccdc_sso_keycloak_admin_password }}
      # --- HTTP / hostname (lab: plain HTTP, relaxed hostname checks) ---
      - KC_HTTP_ENABLED=true
      - KC_HOSTNAME_STRICT=false
    ports:
      - "{{ ccdc_sso_keycloak_port }}:8080"
    depends_on:
      postgres:
        condition: service_healthy

  waitapi:
    image: {{ ccdc_sso_api_image }}
    restart: unless-stopped
    ports:
      - "{{ ccdc_sso_waitapi_port }}:80"
    volumes:
      - ./waitapi/index.json:/usr/share/nginx/html/index.json:ro
      - ./waitapi/default.conf:/etc/nginx/conf.d/default.conf:ro

  rideapi:
    image: {{ ccdc_sso_api_image }}
    restart: unless-stopped
    ports:
      - "{{ ccdc_sso_rideapi_port }}:80"
    volumes:
      - ./rideapi/index.json:/usr/share/nginx/html/index.json:ro
      - ./rideapi/default.conf:/etc/nginx/conf.d/default.conf:ro

volumes:
  postgres_data:
    driver: local
